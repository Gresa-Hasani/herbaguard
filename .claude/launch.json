{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "E:\\herbaguard\\backend\\.venv\\Scripts\\uvicorn.exe",
      "runtimeArgs": ["herbaguard.main:app", "--app-dir", "E:\\herbaguard\\backend\\src", "--host", "127.0.0.1", "--port", "18012"],
      "cwd": "E:\\herbaguard",
      "port": 18012
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "E:\\herbaguard\\frontend", "run", "dev", "--", "--host", "127.0.0.1", "--port", "5174", "--strictPort"],
      "cwd": "E:\\herbaguard\\frontend",
      "env": {
        "HERBAGUARD_API_URL": "http://127.0.0.1:18012",
        "HERBAGUARD_PROXY_TIMEOUT_MS": "600000"
      },
      "port": 5174
    }
  ]
}
