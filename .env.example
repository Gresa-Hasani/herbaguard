# Copy to `.env` and adjust. `.env` is git-ignored — never commit real credentials.

# --- Docker Compose ---------------------------------------------------------
POSTGRES_USER=herbaguard
POSTGRES_PASSWORD=herbaguard
POSTGRES_DB=herbaguard
HERBAGUARD_DB_HOST_PORT=5455
HERBAGUARD_API_HOST_PORT=18010
HERBAGUARD_WEB_HOST_PORT=18080

# --- Backend (also read by the API when run outside Docker) -----------------
HERBAGUARD_ENVIRONMENT=development
HERBAGUARD_LOG_LEVEL=INFO
# console | json (defaults to json in production)
# HERBAGUARD_LOG_FORMAT=console
HERBAGUARD_DATABASE_URL=postgresql+psycopg://herbaguard:herbaguard@127.0.0.1:5455/herbaguard
HERBAGUARD_CORS_ORIGINS=["http://localhost:5173","http://localhost:18080"]
HERBAGUARD_RAW_DATA_DIR=../data/raw

# Optional: identifies HerbaGuard to NCBI / openFDA / Wikidata (recommended by those services).
# HERBAGUARD_CONTACT_EMAIL=

# --- Phase 2+ (not used yet) -------------------------------------------------
# NCBI_API_KEY=
# OPENFDA_API_KEY=
# --- Phase 5: AI evidence assistant (ADR-009: local Ollama) -------------------
# ollama = local LLM with automatic extractive fallback; none = extractive answers only.
HERBAGUARD_ASSISTANT_PROVIDER=ollama
# Outside Docker. Inside Docker Compose the api service uses http://host.docker.internal:11434.
HERBAGUARD_OLLAMA_BASE_URL=http://127.0.0.1:11434
# `ollama pull qwen2.5:3b` and `ollama pull all-minilm` (embedding model must be 384-d).
HERBAGUARD_OLLAMA_CHAT_MODEL=qwen2.5:3b
HERBAGUARD_OLLAMA_EMBED_MODEL=all-minilm
# CPU-only inference is slow; raise if answers time out.
# HERBAGUARD_OLLAMA_TIMEOUT_SECONDS=180
