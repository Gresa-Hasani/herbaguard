# Copy to `.env` and adjust. `.env` is git-ignored — never commit real credentials.

# --- Docker Compose ---------------------------------------------------------
POSTGRES_USER=herbaguard
POSTGRES_PASSWORD=herbaguard
POSTGRES_DB=herbaguard
HERBAGUARD_DB_HOST_PORT=5455
HERBAGUARD_API_HOST_PORT=18010
HERBAGUARD_WEB_HOST_PORT=18080

# --- Backend (also read by the API when run outside Docker) -----------------
HERBAGUARD_ENVIRONMENT=development
HERBAGUARD_LOG_LEVEL=INFO
# console | json (defaults to json in production)
# HERBAGUARD_LOG_FORMAT=console
HERBAGUARD_DATABASE_URL=postgresql+psycopg://herbaguard:herbaguard@127.0.0.1:5455/herbaguard
HERBAGUARD_CORS_ORIGINS=["http://localhost:5173","http://localhost:18080"]
HERBAGUARD_RAW_DATA_DIR=../data/raw

# Optional: identifies HerbaGuard to NCBI / openFDA / Wikidata (recommended by those services).
# HERBAGUARD_CONTACT_EMAIL=

# --- Phase 2+ (not used yet) -------------------------------------------------
# NCBI_API_KEY=
# OPENFDA_API_KEY=
# --- Phase 5: AI layer (docs/ai/llm-providers.md) -----------------------------
# Answer generator: ollama (local, default) | anthropic | openai | extractive (no model).
HERBAGUARD_LLM_PROVIDER=ollama
# Ollama model tag. `ollama pull qwen3:4b` — or use an already installed Qwen3-4B tag.
HERBAGUARD_LLM_MODEL=qwen3:4b
# Optional explicit fallback (never used unless set), e.g. extractive:
HERBAGUARD_LLM_FALLBACK_PROVIDER=extractive
HERBAGUARD_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Docker: the API container reaches the host's Ollama here.
# HERBAGUARD_DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
# HERBAGUARD_LLM_TIMEOUT_SECONDS=240
# Cloud providers (optional; never required). Model ids have no default: choose them yourself.
# HERBAGUARD_ANTHROPIC_API_KEY=
# HERBAGUARD_ANTHROPIC_MODEL=
# HERBAGUARD_OPENAI_API_KEY=
# HERBAGUARD_OPENAI_MODEL=
# HERBAGUARD_OPENAI_BASE_URL=https://api.openai.com/v1
# Licensing guard: source text is sent to a cloud provider only if this is true, and only from
# sources registered as redistributable. Check the source licences before enabling.
# HERBAGUARD_AI_CLOUD_SEND_SOURCE_TEXT=false
# Embeddings (independent of the generator): ollama | none (keyword retrieval only).
HERBAGUARD_EMBEDDING_PROVIDER=ollama
HERBAGUARD_EMBEDDING_MODEL=nomic-embed-text
# Retrieval and context limits (benchmarkable; see docs/ai/hybrid-retrieval.md)
# HERBAGUARD_RETRIEVAL_TOP_K=10
# HERBAGUARD_AI_CONTEXT_MAX_TOKENS=2600
